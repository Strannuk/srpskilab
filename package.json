{
  "name": "srpskilab",
  "private": true,
  "version": "3.0.0-study-edition",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "seed:generate": "node scripts/seed-data.cjs",
    "content:convert": "node scripts/convert-legacy.cjs",
    "audio:generate": "python scripts/generate-audio.py",
    "audio:verify": "python scripts/check-audio.py",
    "content:verify": "node scripts/verify-content.cjs",
    "content:v3:plan": "node scripts/build-syllabus-v3.cjs",
    "content:v3:workbooks": "node scripts/build-workbooks-265.cjs",
    "content:v3:audit": "node scripts/audit-course-v3.cjs",
    "content:v3:validate": "node scripts/validate-pilot-v3.cjs",
    "audio:v3:pilot": "python scripts/generate-pilot-audio.py",
    "content:v3:export": "node scripts/export-pilot-manuscript.cjs",
    "content:v3:authorA0": "python scripts/write-a0-pilots.py && python scripts/write-a0-2to4.py",
    "content:v3:verify": "node scripts/verify-v3-ready.cjs",
    "audio:v3:study": "python scripts/generate-study-audio-v3.py",
    "audio:coverage": "node scripts/verify-audio-coverage.cjs",
    "smoke": "node scripts/smoke-without-vite.cjs && node scripts/ssr-render-smoke.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.1"
  }
}
